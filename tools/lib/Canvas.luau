--[[
	Canvas — tiny RGB raster with PNG export, for visual previews generated by Lune tooling.
	Colors are { r, g, b } tables with 0..255 components.
]]

local serde = require("@lune/serde")

export type Color = { number }

export type Canvas = {
	width: number,
	height: number,
	pixels: buffer,
}

local Canvas = {}

function Canvas.new(width: number, height: number, background: Color): Canvas
	local pixels = buffer.create(width * height * 3)
	local canvas = { width = width, height = height, pixels = pixels }
	Canvas.fillRect(canvas, 0, 0, width - 1, height - 1, background)
	return canvas
end

local function clampByte(value: number): number
	return math.clamp(math.floor(value + 0.5), 0, 255)
end

function Canvas.shade(color: Color, factor: number): Color
	return { clampByte(color[1] * factor), clampByte(color[2] * factor), clampByte(color[3] * factor) }
end

function Canvas.mix(a: Color, b: Color, t: number): Color
	return {
		clampByte(a[1] + (b[1] - a[1]) * t),
		clampByte(a[2] + (b[2] - a[2]) * t),
		clampByte(a[3] + (b[3] - a[3]) * t),
	}
end

function Canvas.set(canvas: Canvas, x: number, y: number, color: Color)
	x, y = math.floor(x), math.floor(y)
	if x < 0 or y < 0 or x >= canvas.width or y >= canvas.height then
		return
	end
	local offset = (y * canvas.width + x) * 3
	buffer.writeu8(canvas.pixels, offset, color[1])
	buffer.writeu8(canvas.pixels, offset + 1, color[2])
	buffer.writeu8(canvas.pixels, offset + 2, color[3])
end

function Canvas.blend(canvas: Canvas, x: number, y: number, color: Color, alpha: number)
	x, y = math.floor(x), math.floor(y)
	if x < 0 or y < 0 or x >= canvas.width or y >= canvas.height then
		return
	end
	local offset = (y * canvas.width + x) * 3
	for channel = 0, 2 do
		local current = buffer.readu8(canvas.pixels, offset + channel)
		buffer.writeu8(canvas.pixels, offset + channel, clampByte(current + (color[channel + 1] - current) * alpha))
	end
end

function Canvas.fillRect(canvas: Canvas, x0: number, y0: number, x1: number, y1: number, color: Color)
	for y = math.max(0, math.floor(y0)), math.min(canvas.height - 1, math.floor(y1)) do
		for x = math.max(0, math.floor(x0)), math.min(canvas.width - 1, math.floor(x1)) do
			Canvas.set(canvas, x, y, color)
		end
	end
end

-- Scanline fill of a simple polygon given as { {x, y}, ... }. Optional alpha blending.
function Canvas.fillPolygon(canvas: Canvas, points: { { number } }, color: Color, alpha: number?)
	local minY, maxY = math.huge, -math.huge
	for _, point in points do
		minY = math.min(minY, point[2])
		maxY = math.max(maxY, point[2])
	end
	local count = #points
	for y = math.max(0, math.floor(minY)), math.min(canvas.height - 1, math.ceil(maxY)) do
		local scan = y + 0.5
		local crossings = {}
		for index = 1, count do
			local a = points[index]
			local b = points[index % count + 1]
			if (a[2] <= scan and b[2] > scan) or (b[2] <= scan and a[2] > scan) then
				table.insert(crossings, a[1] + (scan - a[2]) / (b[2] - a[2]) * (b[1] - a[1]))
			end
		end
		table.sort(crossings)
		for index = 1, #crossings - 1, 2 do
			for x = math.max(0, math.floor(crossings[index] + 0.5)), math.min(canvas.width - 1, math.floor(crossings[index + 1] - 0.5)) do
				if alpha then
					Canvas.blend(canvas, x, y, color, alpha)
				else
					Canvas.set(canvas, x, y, color)
				end
			end
		end
	end
end

function Canvas.line(canvas: Canvas, x0: number, y0: number, x1: number, y1: number, color: Color, alpha: number?)
	local steps = math.max(math.abs(x1 - x0), math.abs(y1 - y0), 1)
	for step = 0, steps do
		local t = step / steps
		local x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
		if alpha then
			Canvas.blend(canvas, x, y, color, alpha)
		else
			Canvas.set(canvas, x, y, color)
		end
	end
end

function Canvas.circle(canvas: Canvas, cx: number, cy: number, radius: number, color: Color, alpha: number?)
	for y = math.floor(cy - radius), math.ceil(cy + radius) do
		for x = math.floor(cx - radius), math.ceil(cx + radius) do
			if (x - cx) ^ 2 + (y - cy) ^ 2 <= radius * radius then
				if alpha then
					Canvas.blend(canvas, x, y, color, alpha)
				else
					Canvas.set(canvas, x, y, color)
				end
			end
		end
	end
end

function Canvas.ring(canvas: Canvas, cx: number, cy: number, radius: number, color: Color, alpha: number?)
	local steps = math.max(32, math.floor(radius * 6))
	for step = 0, steps do
		local angle = step / steps * math.pi * 2
		local x, y = cx + math.cos(angle) * radius, cy + math.sin(angle) * radius
		if alpha then
			Canvas.blend(canvas, x, y, color, alpha)
		else
			Canvas.set(canvas, x, y, color)
		end
	end
end

-- PNG encoding ---------------------------------------------------------------------------------

local CRC_TABLE: { number } = {}
for n = 0, 255 do
	local c = n
	for _ = 1, 8 do
		if bit32.band(c, 1) == 1 then
			c = bit32.bxor(0xEDB88320, bit32.rshift(c, 1))
		else
			c = bit32.rshift(c, 1)
		end
	end
	CRC_TABLE[n] = c
end

local function crc32(data: string): number
	local crc = 0xFFFFFFFF
	for index = 1, #data do
		local byte = string.byte(data, index)
		crc = bit32.bxor(CRC_TABLE[bit32.band(bit32.bxor(crc, byte), 0xFF)], bit32.rshift(crc, 8))
	end
	return bit32.bxor(crc, 0xFFFFFFFF)
end

local function u32(value: number): string
	return string.pack(">I4", value)
end

local function chunk(kind: string, data: string): string
	return u32(#data) .. kind .. data .. u32(crc32(kind .. data))
end

function Canvas.encodePng(canvas: Canvas): string
	local rowBytes = canvas.width * 3
	local raw = buffer.create((rowBytes + 1) * canvas.height)
	for y = 0, canvas.height - 1 do
		local rowStart = y * (rowBytes + 1)
		buffer.writeu8(raw, rowStart, 0) -- filter: none
		buffer.copy(raw, rowStart + 1, canvas.pixels, y * rowBytes, rowBytes)
	end
	local header = u32(canvas.width) .. u32(canvas.height) .. string.char(8, 2, 0, 0, 0)
	local compressed = serde.compress("zlib", buffer.tostring(raw))
	return "\137PNG\r\n\26\n" .. chunk("IHDR", header) .. chunk("IDAT", compressed) .. chunk("IEND", "")
end

return Canvas
