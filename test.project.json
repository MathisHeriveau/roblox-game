{
  "name": "roblox-game-tests",
  "emitLegacyScripts": true,
  "globIgnorePaths": ["**/.DS_Store"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": { "optional": "Packages" }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "Tests": {
        "$path": "tests"
      },
      "DevPackages": {
        "$path": "DevPackages"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
