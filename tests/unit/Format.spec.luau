--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage.Shared.Game.Format)

return function()
	describe("Format.number", function()
		it("groups thousands", function()
			expect(Format.number(0)).to.equal("0")
			expect(Format.number(999)).to.equal("999")
			expect(Format.number(1234567)).to.equal("1,234,567")
		end)
		it("is safe with hostile input", function()
			expect(Format.number(0 / 0)).to.equal("0")
			expect(Format.number(math.huge)).to.equal("0")
			expect(Format.number(-3)).to.equal("0")
		end)
	end)

	describe("Format.compact", function()
		it("keeps three significant digits with suffixes", function()
			expect(Format.compact(999)).to.equal("999")
			expect(Format.compact(1000)).to.equal("1K")
			expect(Format.compact(1250)).to.equal("1.25K")
			expect(Format.compact(45600)).to.equal("45.6K")
			expect(Format.compact(123456)).to.equal("123K")
			expect(Format.compact(1234567)).to.equal("1.23M")
			expect(Format.compact(2 * 10 ^ 9)).to.equal("2B")
		end)
		it("is safe with hostile input", function()
			expect(Format.compact(0 / 0)).to.equal("0")
			expect(Format.compact(-1)).to.equal("0")
		end)
	end)

	describe("Format.duration", function()
		it("formats minutes and hours", function()
			expect(Format.duration(0)).to.equal("0:00")
			expect(Format.duration(65)).to.equal("1:05")
			expect(Format.duration(3723)).to.equal("1:02:03")
			expect(Format.duration(9.9)).to.equal("0:09")
		end)
		it("is safe with hostile input", function()
			expect(Format.duration(-4)).to.equal("0:00")
			expect(Format.duration(0 / 0)).to.equal("0:00")
		end)
	end)
end
