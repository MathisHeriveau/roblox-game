{
  "name": "roblox-game",
  "emitLegacyScripts": true,
  "globIgnorePaths": ["**/*.spec.luau", "**/.DS_Store"],
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true,
          "GrassLength": 0.7
        }
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": { "optional": "Packages" }
      },
      "Models": {
        "$path": { "optional": "assets/models/roblox" }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
